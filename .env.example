# Provider — "anthropic" ou "openai" (se vazio, auto-detecta pela API key disponível)
MODEL_PROVIDER=anthropic

# Anthropic API (usado se MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI API (usado se MODEL_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Email (SMTP) — para Gmail use App Password: https://myaccount.google.com/apppasswords
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=app_password_de_16_chars
EMAIL_TO=destinatario@exemplo.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_NAME=News Agent

# Opcional: token GitHub para evitar rate limit no fetch_github_trending
# GITHUB_TOKEN=ghp_...

# Para testar sem enviar email, descomente:
# DRY_RUN=1
